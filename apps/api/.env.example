# App connection. Local: the docker compose / system Postgres below.
# Neon: use the pooled URL (host contains `-pooler`).
DATABASE_URL=postgresql://ledgerline:ledgerline@localhost:5432/ledgerline
# Optional: non-pooled URL used only by Prisma Migrate (Neon: same host without `-pooler`).
# Falls back to DATABASE_URL when unset.
# DIRECT_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Database the API tests migrate and truncate. Name must end in _test; never your dev data.
# Defaults to the local/CI one below. Neon: a separate database, direct (non-pooler) host.
# TEST_DATABASE_URL=postgresql://ledgerline:ledgerline@localhost:5432/ledgerline_test
WEB_ORIGIN=http://localhost:3000
PORT=4000
# Which proxies may set X-Forwarded-For (client IP for throttling). loopback = Next.js rewrite on this host.
TRUST_PROXY=loopback
# Login / register attempts per minute per IP.
AUTH_THROTTLE_LIMIT=5
# Anchor date for the demo seed and screenshot tests (YYYY-MM-DD)
SEED_TODAY=2026-11-22
