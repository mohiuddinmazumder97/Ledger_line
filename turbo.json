{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".next/**", "!.next/cache/**"] },
    "dev": { "cache": false, "persistent": true },
    "lint": { "dependsOn": ["^build"] },
    "typecheck": { "dependsOn": ["^build"] },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_URL",
        "DIRECT_URL",
        "TEST_DATABASE_URL",
        "WEB_ORIGIN",
        "PORT",
        "SEED_TODAY",
        "TRUST_PROXY",
        "AUTH_THROTTLE_LIMIT"
      ]
    },
    "e2e": { "cache": false }
  }
}
